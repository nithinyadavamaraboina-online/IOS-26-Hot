    <string name="config_ims_rcs_package" translatable="false">vendor.qti.imsrcs</string>

    <!-- Disable AOSP UCE capability polling when QTI UCE/ImsRcsService manages SIP OPTIONS/PUBLISH -->
    <bool name="config_rcs_user_capability_exchange_enabled">false</bool>

    <!-- Dual-SIM / World Phone & APN settings for RMX1931 -->
    <bool name="world_phone">true</bool>
    <bool name="config_apn_expand">true</bool>
    <bool name="config_show_apn_setting_cdma">true</bool>
</resources>
