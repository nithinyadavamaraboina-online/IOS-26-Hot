 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
 }
+
+extern "C" void
+sweet_hid_touch_frame(uint64_t scan_ts, uint32_t active_mask, const int *xs, const int *ys)
+{
+	if (gSweetTouch) {
+		gSweetTouch->touchFrame(scan_ts, active_mask, xs, ys);
+	}
+}
