+#define SWEET_SPI_BASE  32u
+#define SWEET_SPI_MAX   640u
+
+static struct {
+	sweet_irq_fn_t fn;
+	void *arg;
+} sweet_spi_table[SWEET_SPI_MAX];
+
+static void
+gicd_wait_rwp(void)
+{
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+}
+
+void
+sweet_gic_mask_spi(unsigned int intid)
+{
+	if (gicd_base && intid >= SWEET_SPI_BASE && intid < SWEET_SPI_BASE + SWEET_SPI_MAX) {
+		gicd_write32(GICD_ICENABLER + 4u * (intid / 32u), 1u << (intid % 32u));
+		__builtin_arm_dsb(DSB_SY);
+	}
+}
+
+void
+sweet_gic_unmask_spi(unsigned int intid)
+{
+	if (gicd_base && intid >= SWEET_SPI_BASE && intid < SWEET_SPI_BASE + SWEET_SPI_MAX) {
+		gicd_write32(GICD_ISENABLER + 4u * (intid / 32u), 1u << (intid % 32u));
+		__builtin_arm_dsb(DSB_SY);
+	}
+}
+
+void
+sweet_gic_register_spi(unsigned int intid, int edge_rising, sweet_irq_fn_t fn, void *arg)
+{
+	if (!gicd_base || intid < SWEET_SPI_BASE || intid >= SWEET_SPI_BASE + SWEET_SPI_MAX) {
+		return;
+	}
+	unsigned int idx = intid - SWEET_SPI_BASE;
+	gicd_write32(GICD_ICENABLER + 4u * (intid / 32u), 1u << (intid % 32u));
+	gicd_wait_rwp();
+
+	sweet_spi_table[idx].arg = arg;
+	os_atomic_store(&sweet_spi_table[idx].fn, fn, release);
+	if (fn == NULL) {
+		return;
+	}
+
+	/* SecurityExtn=1: GICD_IGROUPR reads as 0 from NS; write all Group 1 NS bits. */
+	gicd_write32(GICD_IGROUPR + 4u * (intid / 32u), 0xFFFFFFFFu);
+
+	uint32_t pri_off = GICD_IPRIORITYR + 4u * (intid / 4u);
+	uint32_t pri_shift = 8u * (intid % 4u);
+	uint32_t pri = gicd_read32(pri_off);
+	pri = (pri & ~(0xFFu << pri_shift)) | (0xA0u << pri_shift);
+	gicd_write32(pri_off, pri);
+
+	uint32_t cfg_off = GICD_ICFGR + 4u * (intid / 16u);
+	uint32_t cfg_shift = 2u * (intid % 16u);
+	uint32_t cfg = gicd_read32(cfg_off);
+	cfg = (cfg & ~(3u << cfg_shift)) | ((edge_rising ? 2u : 0u) << cfg_shift);
+	gicd_write32(cfg_off, cfg);
+
+	/* Route SPI to cpu0 (MPIDR Aff=0). */
+	gicd_write64(GICD_IROUTER + 8ULL * (uint64_t)intid, 0ULL);
+	if (edge_rising) {
+		gicd_write32(GICD_ICPENDR + 4u * (intid / 32u), 1u << (intid % 32u));
+	}
+	gicd_wait_rwp();
+	gicd_write32(GICD_ISENABLER + 4u * (intid / 32u), 1u << (intid % 32u));
+	__builtin_arm_dsb(DSB_SY);
+}
+
+int
+sweet_gic_dispatch_spi(unsigned int intid)
+{
+	if (intid >= SWEET_SPI_BASE && intid < SWEET_SPI_BASE + SWEET_SPI_MAX) {
+		unsigned int idx = intid - SWEET_SPI_BASE;
+		sweet_irq_fn_t fn = os_atomic_load(&sweet_spi_table[idx].fn, acquire);
+		if (fn != NULL) {
+			fn(sweet_spi_table[idx].arg);
+			return 1;
+		}
+	}
++	return 0;
+}
+#endif /* SWEET */
