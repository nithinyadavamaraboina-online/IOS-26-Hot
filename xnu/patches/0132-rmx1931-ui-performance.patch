+void
+SweetHIDTouch::touchFrame(uint64_t scan_ts, uint32_t active_mask, const int *xs, const int *ys)
+{
+	uint64_t now = scan_ts ? scan_ts : mach_absolute_time();
+
+	IOLockLock(fLock);
+	int fitX = sweet_display_fit_x, fitY = sweet_display_fit_y;
+	int fitW = sweet_display_fit_w, fitH = sweet_display_fit_h;
+	if (fitW <= 0 || fitH <= 0) {
+		fitX = fitY = 0;
+		fitW = SWEET_PANEL_W;
+		fitH = SWEET_PANEL_H;
+	}
+	int ext = fCornerRadius ? (int)sweet_display_corner_extent(fCornerRadius) : 0;
+
+	bool nextDown[SWEET_TOUCH_FINGERS];
+	bool changed[SWEET_TOUCH_FINGERS];
+	bool moved[SWEET_TOUCH_FINGERS];
+	IOFixed nextX[SWEET_TOUCH_FINGERS];
+	IOFixed nextY[SWEET_TOUCH_FINGERS];
+	bool anyChanged = false, anyDown = false;
+	int leadFinger = -1;
+
+	for (int i = 0; i < SWEET_TOUCH_FINGERS; i++) {
+		bool was = fDown[i];
+		bool down = ((active_mask >> i) & 1u) != 0;
+		int x = xs ? xs[i] : 0;
+		int y = ys ? ys[i] : 0;
+		x = x < 0 ? 0 : (x > SWEET_PANEL_W - 1 ? SWEET_PANEL_W - 1 : x);
+		y = y < 0 ? 0 : (y > SWEET_PANEL_H - 1 ? SWEET_PANEL_H - 1 : y);
+
+		if (!was && down && ext > 0) {
+			int cx = x - fitX < ext ? x - fitX : (fitX + fitW - 1 - x < ext ? fitX + fitW - 1 - x : -1);
+			int cy = y - fitY < ext ? y - fitY : (fitY + fitH - 1 - y < ext ? fitY + fitH - 1 - y : -1);
+			if (cx >= 0 && cy >= 0 && !sweet_display_corner_point_visible((uint32_t)cx, (uint32_t)cy, fCornerRadius)) {
+				down = false;
+			}
+		}
+
+		IOFixed nx = fX[i], ny = fY[i];
+		if (down) {
+			if (sweet_display_fit_w > 0 && sweet_display_fit_h > 0) {
+				int64_t fx = ((int64_t)(x - fitX) * 65536 + fitW / 2) / fitW;
+				nx = (IOFixed)(fx < 0 ? 0 : (fx > 0xffff ? 0xffff : fx));
+				int64_t fy = ((int64_t)(y - fitY) * 65536 + fitH / 2) / fitH;
+				ny = (IOFixed)(fy < 0 ? 0 : (fy > 0xffff ? 0xffff : fy));
+			} else {
+				nx = (IOFixed)(((int64_t)(x + fOffX) << 16) / fLogicalW);
+				ny = (IOFixed)(((int64_t)(y + fOffY) << 16) / fLogicalH);
+			}
+		}
+
+		bool mv = down && was && (nx != fX[i] || ny != fY[i]);
+		bool ch = (was != down) || mv;
+		if (!was && down) {
+			fEdge[i] = x < fitX + SWEET_TOUCH_EDGE_PX || x > fitX + fitW - 1 - SWEET_TOUCH_EDGE_PX ||
+			    y < fitY + SWEET_TOUCH_EDGE_PX || y > fitY + fitH - 1 - SWEET_TOUCH_EDGE_PX;
+		}
+		if (was != down && (fLog || fLoggedCount < 16)) {
+			fLoggedCount++;
+			IOLog("SWEET HID: touch %d %s at %d,%d%s\n", i, down ? "down" : "up", x, y,
+			    fEdge[i] ? " edge" : "");
+		}
+		nextDown[i] = down;
+		changed[i] = ch;
+		moved[i] = mv;
+		nextX[i] = nx;
+		nextY[i] = ny;
+		if (ch) {
+			anyChanged = true;
+			if (leadFinger < 0) {
+				leadFinger = i;
+			}
+		}
+		if (down) {
+			anyDown = true;
+			if (leadFinger < 0) {
+				leadFinger = i;
+			}
+		}
+	}
+
+	if (!anyChanged) {
+		IOLockUnlock(fLock);
+		return;
+	}
+
+	IOHIDEvent *collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
+	if (!collection) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection, TRUE);
+
+	UInt32 cmask = 0;
+	for (int i = 0; i < SWEET_TOUCH_FINGERS; i++) {
+		bool was = fDown[i];
+		bool d = nextDown[i];
+		if (!d && !was) {
+			continue;
+		}
+		IOHIDEvent *child = IOHIDEvent::digitizerEvent(now, (UInt32)i + 2, kIOHIDDigitizerTransducerTypeFinger,
+		    d, d ? 1 : 0, nextX[i], nextY[i]);
+		if (!child) {
+			continue;
+		}
+		UInt32 mask = fEdge[i] ? kIOHIDDigitizerEventFromEdgeTip : 0;
+		if (was != d) {
+			mask |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+		}
+		if (moved[i]) {
+			mask |= kIOHIDDigitizerEventPosition;
+		}
+		if (!was && d) {
+			mask |= kIOHIDDigitizerEventIdentity;
+		}
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, i);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, i + 2);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, d);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+		collection->appendChild(child);
+		child->release();
+		cmask |= mask;
+		fDown[i] = d;
+		if (d) {
+			fX[i] = nextX[i];
+			fY[i] = nextY[i];
+		}
+	}
+	if (leadFinger < 0) {
+		leadFinger = 0;
+	}
+	collection->setFixedValue(kIOHIDEventFieldDigitizerX, nextX[leadFinger]);
+	collection->setFixedValue(kIOHIDEventFieldDigitizerY, nextY[leadFinger]);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerRange, anyDown);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch, anyDown);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, cmask);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, anyDown ? 1 : 0);
+	IOLockUnlock(fLock);
+
+	dispatchEvent(collection);
+	collection->release();
+}
+
