 }
 
+uint32_t
+thread_group_copy_all(struct thread_group **out, uint32_t cap)
+{
+	struct thread_group *tg;
+	uint32_t n = 0;
+
+	lck_mtx_lock(&tg_lock);
+	qe_foreach_element(tg, &tg_queue, tg_queue_chain) {
+		if (n >= cap) {
+			break;
+		}
+		if (thread_group_retain_try(tg)) {
+			out[n++] = tg;
+		}
+	}
+	lck_mtx_unlock(&tg_lock);
+	return n;
+}
