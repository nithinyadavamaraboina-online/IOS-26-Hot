+			continue;
+		}
+		if (pset->pset_type == CLUSTER_TYPE_P && p_id < 0) {
+			p_id = cid;
+		} else if (pset->pset_type == CLUSTER_TYPE_E && e_id < 0) {
+			e_id = cid;
+		}
+	}
+	if (p_id >= 0 && e_id >= 0) {
+		sweet_edge_p_cluster = p_id;
+		sweet_edge_e_cluster = e_id;
+		uint32_t pref[TH_BUCKET_SCHED_MAX];
+		for (sched_bucket_t b = TH_BUCKET_FIXPRI; b < TH_BUCKET_SCHED_MAX; b++) {
+			pref[b] = (b <= TH_BUCKET_SHARE_DF) ? (uint32_t)p_id : (uint32_t)e_id;
+		}
+		struct thread_group **tgs = kalloc_type(struct thread_group *, 256, Z_WAITOK | Z_ZERO);
+		if (tgs != NULL) {
+			uint32_t ntg = thread_group_copy_all(tgs, 256);
+			for (uint32_t i = 0; i < ntg; i++) {
+				sched_edge_tg_preferred_cluster_change(tgs[i], pref,
+				    SCHED_PERFCONTROL_PREFERRED_CLUSTER_MIGRATE_RUNNING |
+				    SCHED_PERFCONTROL_PREFERRED_CLUSTER_MIGRATE_RUNNABLE);
+				thread_group_release(tgs[i]);
+			}
+			kfree_type(struct thread_group *, 256, tgs);
+			kprintf("SWEET SCHED: Edge AMP active (E=pset%d P=pset%d, migrated %u thread groups)\n",
+			    e_id, p_id, ntg);
+		}
+	}
+#endif /* SWEET */
 }
 
 static bool
